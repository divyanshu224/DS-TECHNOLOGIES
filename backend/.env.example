PORT=5000
NODE_ENV=production
# Atlas example (encode @ in password as %40):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ds-technologies?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ds-technologies
JWT_SECRET=change_me_to_long_random_string
JWT_EXPIRE=7d
CLIENT_URL=*
